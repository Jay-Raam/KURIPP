# ---------------------------------------------------------------------------
# KURIPP — Environment Configuration Template
# Strictly names and template placeholders only. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# Gateway Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Client Configuration
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
NEXT_PUBLIC_SOCKET_ENDPOINT=http://localhost:4000

# PostgreSQL 16 (with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kuripp_dev?schema=public

# MongoDB 7
MONGODB_URI=mongodb://localhost:27017/kuripp_dev

# Redis 7
REDIS_URL=redis://localhost:6379

# Cryptography & Security Secrets
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_secret
JWT_REFRESH_SECRET=replace_with_min_32_char_cryptographically_secure_refresh_secret
COOKIE_SECRET=replace_with_min_32_char_cookie_encryption_secret

# AI & LLM Provider (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Model Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Object Storage (Cloudflare R2 / MinIO S3-Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=kuripp-documents
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Email Transporter (Nodemailer / Mailpit)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="KURIPP System" <no-reply@kuripp.local>

# Proactive WhatsApp Gateway (Evolution API)
WHATSAPP_PROVIDER=evolution_api
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=your_evolution_api_instance_key
ALERT_WHATSAPP_NUMBER=919876543210

# Monitoring & Error Reporting (Optional)
SENTRY_DSN=
