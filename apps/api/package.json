{
  "name": "@kuripp/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@graphql-yoga/plugin-defer-stream": "^3.12.3",
    "@kuripp/graphql-schema": "workspace:*",
    "@kuripp/shared-types": "workspace:*",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "nodemailer": "^10.0.14",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17"
  },
  "devDependencies": {
    "@kuripp/eslint-config": "workspace:*",
    "@kuripp/tsconfig": "workspace:*",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
